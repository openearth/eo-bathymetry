    "# Load gebco tif\n",
    "da_gebco = rxr.open_rasterio(file_path_gebco_tif)\n",
    "\n",
    "# Initialise arrays for hat and lat\n",
    "hats = np.zeros(len(gdf_gtsm_stations))\n",
    "lats = np.zeros(len(gdf_gtsm_stations))\n",
    "\n",
    "# Get nearest gebco value to gtsm stations\n",
    "for i, row in tqdm(gdf_gtsm_stations.iterrows(), total=len(gdf_gtsm_stations)):\n",
    "    # Get an area of 2 degrees around the station\n",
    "    buffer = 2\n",
    "    x, y = row['geometry'].x, row['geometry'].y\n",
    "    bounds = (x-buffer/2, y-buffer/2, x+buffer/2, y+buffer/2)\n",
    "    da_gebco_station = da_gebco.rio.clip_box(*bounds)\n",
    "\n",
    "    # Interpolate missing data\n",
    "    da_gebco_station = da_gebco_station.rio.interpolate_na(method='nearest')\n",
    "\n",
    "    # Get hat and lat at station\n",
    "    hat, lat = da_gebco_station.sel(x=row['geometry'].x, y=row['geometry'].y, method='nearest').values\n",
    "    \n",
    "    # Set hat and lat\n",
    "    hats[i] = hat if hat != 9999 else np.nan\n",
    "    lats[i] = lat if lat != 9999 else np.nan\n",
    "\n",
    "# Add hats and lats to gdf\n",
    "gdf_gtsm_stations['hat'] = hats\n",
    "gdf_gtsm_stations['lat'] = lats\n",
    "\n",
    "# Check number of stations with missing hat and lat\n",
    "print(f'Number of stations with missing hat: {np.isnan(hats).sum()}')\n",
    "print(f'Number of stations with missing lat: {np.isnan(lats).sum()}')"
   ]
  },
