    "# Create stations dataframe\n",
    "df_gtsm_stations = ds_gtsm.to_dataframe()\n",
    "\n",
    "# Drop index\n",
    "df_gtsm_stations = df_gtsm_stations.reset_index(drop=True)\n",
    "\n",
    "# Reorder columns\n",
    "df_gtsm_stations = df_gtsm_stations[['station_id', 'station_name', 'station_x_coordinate', 'station_y_coordinate',\n",
    "                                     'bedlevel', 'waterlevel_mean', 'waterlevel_min', 'waterlevel_max']]\n",
    "\n",
    "# Rename station x and y coordinates to station longitude and latitude\n",
    "df_gtsm_stations = df_gtsm_stations.rename(columns={'station_x_coordinate': 'station_longitude', 'station_y_coordinate': 'station_latitude'})\n",
    "\n",
    "# Convert to geodataframe\n",
    "gdf_gtsm_stations = gpd.GeoDataFrame(df_gtsm_stations, geometry=gpd.points_from_xy(df_gtsm_stations['station_longitude'], df_gtsm_stations['station_latitude']), crs=\"EPSG:4326\")"
