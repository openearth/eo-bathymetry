{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Preprocess Data Workflow"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "1. Convert data (crs = EPSG:4326)\n",
    "\n",
    "    1. Convert GTSM netcdfs to zarr (station id, station location, waterlevels and bed levels)\n",
    "    2. Convert and merge GEBOC tifs (Bathy)\n",
    "    3. Convert and merge GEBCO netcdfs to tifs (LAT, HAT, LAT & HAT)\n",
    "    4. Convert feasability map geojson(s) to parquet(s)\n",
    "    5. Convert tiles geojson to tiles parquet (remove faulty tiles)\n",
    "\n",
    "2. Filter data\n",
    "    1. Create GTSM stations metadata parquet\n",
    "    2. Create erosion-dilation feasability map parquet\n",
    "    3. Create tiles metadata parquet\n",
    "    4. Create OSM metadata parquet\n",
    "\n",
    "3. Upload data to earth engine\n",
    "    1. Convert GTSM zarr to csv\n",
    "    2. Upload GTSM csv to earth engine\n",
    "    3. Upload GEBCO tifs to earth engine"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Conversion of data"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1.1. Convert and merge GTSM netcdfs to zarr (station ids, water levels and bed levels)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Packages\n",
    "import glob\n",
    "import os\n",
    "from tqdm import tqdm\n",
    "import xarray as xr"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# File paths in\n",
    "file_path_gtsm_ncs = r'p:\\1230882-emodnet_hrsm\\GTSMv3.0EMODnet\\CMEMS_intertidal_SDB\\*\\output\\gtsm_model_0000_his.nc'\n",
    "file_path_gtsm_ncs = glob.glob(file_path_gtsm_ncs)\n",
    "\n",
    "# Years\n",
    "years = [int(file_path_gtsm_nc.split('\\\\')[-3].split('_')[-1]) for file_path_gtsm_nc in file_path_gtsm_ncs]\n",
    "\n",
    "# File paths out\n",
    "dir_path_gtsm_zarrs = r'p:\\1230882-emodnet_hrsm\\GTSMv3.0EMODnet\\CMEMS_intertidal_SDB\\zarr_files'\n",
    "file_path_gtsm_zarrs = [os.path.join(dir_path_gtsm_zarrs, f'gtsm_model_his_{year}.zarr') for year in years]\n",
    "file_path_gtsm_combined_zarr = os.path.join(dir_path_gtsm_zarrs, 'gtsm_model_his_combined_v2.zarr')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "for i, file_path_gtsm_nc in enumerate(tqdm(file_path_gtsm_ncs)):\n",
    "    # Read dataset from netCDF\n",
    "    ds_gtsm = xr.open_dataset(file_path_gtsm_nc)\n",
    "\n",
    "    # Get data within year (removing spin-up)\n",
    "    ds_gtsm_ss = ds_gtsm.sel(time=slice('{}-01-01'.format(years[i]), '{}-12-31'.format(years[i])))\n",
    "\n",
    "    # Get waterlevels and bedlevels\n",
    "    ds_gtsm_ss = ds_gtsm_ss[['station_id', 'waterlevel', 'bedlevel']]\n",
    "\n",
    "    # Write dataset to zarr\n",
    "    ds_gtsm_ss.to_zarr(file_path_gtsm_zarrs[i], mode='w', consolidated=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load first dataset\n",
    "ds_gtsm_comb = xr.open_zarr(file_path_gtsm_zarrs[0])\n",
    "print(f'Year {years[0]}: {ds_gtsm_comb.stations.size} stations, {ds_gtsm_comb.time.size} time steps')\n",
    "\n",
    "# Get station_ids and bedlevels\n",
    "station_ids = ds_gtsm_comb.station_id.values\n",
    "bedlevels = ds_gtsm_comb.bedlevel.values\n",
    "\n",
    "# Load and combine linking timeseries\n",
    "for i, file_path_gtsm_zarr in enumerate(file_path_gtsm_zarrs[1:]):\n",
    "    ds_gtsm = xr.open_zarr(file_path_gtsm_zarr)\n",
    "    print(f'Year {years[i+1]}: {ds_gtsm.stations.size} stations, {ds_gtsm.time.size} time steps')\n",
    "    ds_gtsm_comb = xr.concat([ds_gtsm_comb, ds_gtsm], dim='time')\n",
    "print(f'Combined:  {ds_gtsm_comb.stations.size} stations, {ds_gtsm_comb.time.size} time steps')\n",
    "\n",
    "# Overwrite station_ids and bedlevels\n",
    "ds_gtsm_comb['station_id'] = ('stations', ['station {:05}'.format(i) for i in range(ds_gtsm_comb.stations.size)])\n",
    "ds_gtsm_comb['bedlevel'] = ('stations', bedlevels)\n",
    "\n",
    "# Unify chunks\n",
    "ds_gtsm_comb = ds_gtsm_comb.unify_chunks()\n",
    "\n",
    "# Write combined dataset to zarr\n",
    "ds_gtsm_comb.to_zarr(file_path_gtsm_combined_zarr, mode='w', consolidated=True, safe_chunks=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load combined dataset\n",
    "ds_gtsm_comb = xr.open_zarr(file_path_gtsm_combined_zarr)\n",
    "\n",
    "# Print dataset\n",
    "ds_gtsm_comb"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1.2 Convert and merge GEBCO tifs (bathy)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Packages\n",
    "import glob\n",
    "import os\n",
    "from osgeo import gdal\n",
    "import rioxarray as rxr\n",
    "from tqdm import tqdm\n",
    "\n",
    "gdal.UseExceptions() # Allow GDAL to throw Python Exceptions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Functions\n",
    "def merge_grids_by_xy(file_paths_in, file_path_out, **kwargs):\n",
    "    \"\"\"Merge multiple tifs into one.\n",
    "\n",
    "    :param file_paths_in: List of paths to tifs.\n",
    "    :type file_paths_in:  list\n",
    "    :param file_path_out: Path to output tif.\n",
    "    :type file_path_out:  str\n",
    "    :param kwargs:        Keyword arguments for :func:`gdal.Translate`.\n",
    "    :type kwargs:         dict, optional\n",
    "    :return:              None\n",
    "    :rtype:               None\n",
    "\n",
    "    See also: `gdal.BuildVRT() <https://gdal.org/programs/gdalbuildvrt.html#gdalbuildvrt>`_,\n",
    "    `gdal.Translate() <https://gdal.org/programs/gdal_translate.html#gdal-translate>`_\n",
    "    \"\"\"\n",
    "\n",
    "    # Get file path vrt\n",
    "    file_path_vrt = file_path_out.replace('.tif', '.vrt')\n",
    "\n",
    "    # Get keyword arguments\n",
    "    creationOptions=['DRIVER=GTiff','COMPRESS=LZW','INTERLEAVE=BAND','ZLEVEL=9','PREDICTOR=1', 'BIGTIFF=YES']\n",
    "    kwargs.setdefault('creationOptions', creationOptions)\n",
    "\n",
    "    # Merge tifs\n",
    "    vrt = gdal.BuildVRT(file_path_vrt, file_paths_in)\n",
    "    da = gdal.Translate(file_path_out, vrt, **kwargs)\n",
    "    vrt = da = None\n",
    "\n",
    "    # Remove vrt\n",
    "    if os.path.exists(file_path_vrt):\n",
    "        os.remove(file_path_vrt)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [],
   "source": [
    "# File paths in\n",
    "dir_path_data_in = r'p:\\11209821-cmems-global-sdb\\00_miscellaneous\\Feasibility_maps\\Input\\Original_gebco_2024'\n",
    "file_path_gebco_tifs = glob.glob(os.path.join(dir_path_data_in, '*.tif'))\n",
    "\n",
    "# File paths out\n",
    "dir_path_data_out = r'p:\\11209821-cmems-global-sdb\\01_intertidal\\02_data\\03_gebco_files'\n",
    "file_path_gebco_merge_tif = os.path.join(dir_path_data_out, 'gebco_2024.tif')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Merging the hat and lat tifs by xy\n"
     ]
    }
   ],
   "source": [
    "# Merge the hat and lat tifs by xy\n",
    "print('Merging the hat and lat tifs by xy')\n",
    "if not os.path.exists(file_path_gebco_merge_tif):\n",
    "    merge_grids_by_xy(file_path_gebco_tifs, file_path_gebco_merge_tif)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1.3 Convert and merge GEBCO netcdfs to tifs (LAT, HAT, LAT & HAT)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Packages\n",
    "import glob\n",
    "import os\n",
    "from osgeo import gdal\n",
    "import rioxarray as rxr\n",
    "from tqdm import tqdm\n",
    "\n",
    "gdal.UseExceptions() # Allow GDAL to throw Python Exceptions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Functions\n",
    "def merge_grids_by_xy(file_paths_in, file_path_out, **kwargs):\n",
    "    \"\"\"Merge multiple tifs into one.\n",
    "\n",
    "    :param file_paths_in: List of paths to tifs.\n",
    "    :type file_paths_in:  list\n",
    "    :param file_path_out: Path to output tif.\n",
    "    :type file_path_out:  str\n",
    "    :param kwargs:        Keyword arguments for :func:`gdal.Translate`.\n",
    "    :type kwargs:         dict, optional\n",
    "    :return:              None\n",
    "    :rtype:               None\n",
    "\n",
    "    See also: `gdal.BuildVRT() <https://gdal.org/programs/gdalbuildvrt.html#gdalbuildvrt>`_,\n",
    "    `gdal.Translate() <https://gdal.org/programs/gdal_translate.html#gdal-translate>`_\n",
    "    \"\"\"\n",
    "\n",
    "    # Get file path vrt\n",
    "    file_path_vrt = file_path_out.replace('.tif', '.vrt')\n",
    "\n",
    "    # Get keyword arguments\n",
    "    creationOptions=['DRIVER=GTiff','COMPRESS=LZW','INTERLEAVE=BAND','ZLEVEL=9','PREDICTOR=1', 'BIGTIFF=YES']\n",
    "    kwargs.setdefault('creationOptions', creationOptions)\n",
    "\n",
    "    # Merge tifs\n",
    "    vrt = gdal.BuildVRT(file_path_vrt, file_paths_in)\n",
    "    da = gdal.Translate(file_path_out, vrt, **kwargs)\n",
    "    vrt = da = None\n",
    "\n",
    "    # Remove vrt\n",
    "    if os.path.exists(file_path_vrt):\n",
    "        os.remove(file_path_vrt)\n",
    "\n",
    "def merge_grids_by_band(file_paths_in, file_path_out, **kwargs):\n",
    "    \"\"\"Merge multiple tifs into one by band.\n",
    "\n",
    "    :param file_paths_in: List of paths to tifs.\n",
    "    :type file_paths_in:  list\n",
    "    :param file_path_out: Path to output tif.\n",
    "    :type file_path_out:  str\n",
    "    :param kwargs:        Keyword arguments for :func:`gdal.Translate`.\n",
    "    :type kwargs:         dict, optional\n",
    "    :return:              None\n",
    "    :rtype:               None\n",
    "\n",
    "    See also: `gdal.BuildVRT() <https://gdal.org/programs/gdalbuildvrt.html#gdalbuildvrt>`_,\n",
    "    `gdal.Translate() <https://gdal.org/programs/gdal_translate.html#gdal-translate>`_\n",
    "    \"\"\"\n",
    "\n",
    "    # Get file path vrt\n",
    "    file_path_vrt = file_path_out.replace('.tif', '.vrt')\n",
    "\n",
    "    # Get keyword arguments\n",
    "    creationOptions=['DRIVER=GTiff','COMPRESS=LZW','INTERLEAVE=BAND','ZLEVEL=9','PREDICTOR=1', 'BIGTIFF=YES']\n",
    "    kwargs.setdefault('creationOptions', creationOptions)\n",
    "\n",
    "    # Merge tifs\n",
    "    vrt = gdal.BuildVRT(file_path_vrt, file_paths_in, separate=True)\n",
    "    da = gdal.Translate(file_path_out, vrt, **kwargs)\n",
    "    vrt = da = None\n",
    "\n",
    "    # Remove vrt\n",
    "    if os.path.exists(file_path_vrt):\n",
    "        os.remove(file_path_vrt)\n",
    "\n",
    "def name_bands(file_path_in, names):\n",
    "    \"\"\"Name bands in a tif file.\n",
    "\n",
    "    :param file_path_in: Path to tif file.\n",
    "    :type file_path_in:  str\n",
    "    :param names:        List of names for the bands.\n",
    "    :type names:         list\n",
    "    :return:             None\n",
    "    :rtype:              None\n",
    "    \"\"\"\n",
    "    \n",
    "    # Open file\n",
    "    da = gdal.Open(file_path_in, gdal.GA_Update)\n",
    "\n",
    "    # Name bands\n",
    "    for i, name in enumerate(names):\n",
    "        band = da.GetRasterBand(i+1)\n",
    "        band.SetDescription(name)\n",
    "\n",
    "    # Close file\n",
    "    da = None"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# File paths in\n",
    "dir_path_data_in = r'p:\\11209821-cmems-global-sdb\\00_miscellaneous\\Feasibility_maps\\Input\\Processed_gebco_2023'\n",
    "file_path_gebco_ncs = glob.glob(os.path.join(dir_path_data_in, '*.nc'))\n",
    "file_path_gebco_tifs = [os.path.join(dir_path_data_in, os.path.basename(file_path).replace('.nc', '.tif')) for file_path in file_path_gebco_ncs]\n",
    "file_path_gebco_hat_tifs = [file_path for file_path in file_path_gebco_tifs if 'hat.tif' in file_path]\n",
    "file_path_gebco_lat_tifs = [file_path for file_path in file_path_gebco_tifs if 'lat.tif' in file_path]\n",
    "\n",
    "# File paths out\n",
    "dir_path_data_out = r'p:\\11209821-cmems-global-sdb\\01_intertidal\\02_data\\03_gebco_files'\n",
    "file_path_gebco_hat_merge_tif = os.path.join(dir_path_data_out, 'gebco_2023_hat.tif')\n",
    "file_path_gebco_lat_merge_tif = os.path.join(dir_path_data_out, 'gebco_2023_lat.tif')\n",
    "file_path_gebco_merge_tif = os.path.join(dir_path_data_out, 'gebco_2023_hat_lat.tif')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Convert the nc files to tif files\n",
    "print('Converting the nc files to tif files')\n",
    "for file_path_nc, file_path_tif in tqdm(zip(file_path_gebco_ncs, file_path_gebco_tifs), total=len(file_path_gebco_ncs)):\n",
    "    # Skip if the tif file already exists\n",
    "    if os.path.exists(file_path_tif):\n",
    "        continue\n",
    "\n",
    "    # Open file\n",
    "    da = rxr.open_rasterio(file_path_nc)\n",
    "\n",
    "    # Write file\n",
    "    da.rio.to_raster(file_path_tif)\n",
    "\n",
    "# Merge the hat and lat tifs by xy\n",
    "print('Merging the hat and lat tifs by xy')\n",
    "if not os.path.exists(file_path_gebco_hat_merge_tif):\n",
    "    merge_grids_by_xy(file_path_gebco_hat_tifs, file_path_gebco_hat_merge_tif)\n",
    "\n",
    "if not os.path.exists(file_path_gebco_lat_merge_tif):\n",
    "    merge_grids_by_xy(file_path_gebco_lat_tifs, file_path_gebco_lat_merge_tif)\n",
    "\n",
    "# Merge the hat and lat tifs by band\n",
    "print('Merging the hat and lat tifs by band')\n",
    "if not os.path.exists(file_path_gebco_merge_tif):\n",
    "    merge_grids_by_band([file_path_gebco_hat_merge_tif, file_path_gebco_lat_merge_tif], file_path_gebco_merge_tif)\n",
    "\n",
    "# Name the bands\n",
    "print('Naming the bands')\n",
    "name_bands(file_path_gebco_merge_tif, ['hat', 'lat'])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1.4 Convert feasability map geojson(s) to parquet(s)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Packages\n",
    "import geopandas as gpd\n",
    "import glob\n",
    "import pandas as pd\n",
    "from tqdm import tqdm"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Select year\n",
    "year = '2024_latminus2'\n",
    "\n",
    "# File paths in\n",
    "file_path_fm_geojsons_dict = {\n",
    "    '2023':           r'p:\\11209821-cmems-global-sdb\\00_miscellaneous\\Feasibility_maps\\2023\\Buffered\\AOI_results\\*\\gebco_2023_*_result.geojson',\n",
    "    '2024':           r'p:\\11209821-cmems-global-sdb\\00_miscellaneous\\Feasibility_maps\\2024\\AOI_results_2024\\gebco_2024_*_result.geojson',\n",
    "    '2024_latminus1': r'p:\\11209821-cmems-global-sdb\\00_miscellaneous\\Feasibility_maps\\2024\\AOI_results_2024_latminus1\\gebco_2024_*_result.geojson',\n",
    "    '2024_latminus2': r'p:\\11209821-cmems-global-sdb\\00_miscellaneous\\Feasibility_maps\\2024\\AOI_results_2024_latminus2\\gebco_2024_*_result.geojson'}\n",
    "file_path_fm_geojsons = glob.glob(file_path_fm_geojsons_dict[year])\n",
    "\n",
    "# File paths out\n",
    "file_path_fm_parquet_dict = {\n",
    "    '2023':           r'p:\\11209821-cmems-global-sdb\\00_miscellaneous\\Feasibility_maps\\Buffered\\AOI_results\\gebco_2023_merge_result.parquet',\n",
    "    '2024':           r'p:\\11209821-cmems-global-sdb\\00_miscellaneous\\Feasibility_maps\\2024\\gebco_2024_merge_result.parquet',\n",
    "    '2024_latminus1': r'p:\\11209821-cmems-global-sdb\\00_miscellaneous\\Feasibility_maps\\2024\\gebco_2024_latminus1_merge_result.parquet',\n",
    "    '2024_latminus2': r'p:\\11209821-cmems-global-sdb\\00_miscellaneous\\Feasibility_maps\\2024\\gebco_2024_latminus2_merge_result.parquet'}\n",
    "file_path_fm_parquet = file_path_fm_parquet_dict[year]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load geodataframes\n",
    "gdf_fm_ls = []\n",
    "for file_path_fm_geojson in tqdm(file_path_fm_geojsons):\n",
    "    gdf_fm_ls.append(gpd.read_file(file_path_fm_geojson))\n",
    "\n",
    "# Merge geodataframes\n",
    "gdf_fm = gpd.GeoDataFrame(pd.concat(gdf_fm_ls, ignore_index=True))\n",
    "\n",
    "# Save merged geodataframe to parquet\n",
    "gdf_fm.to_parquet(file_path_fm_parquet)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load parquet\n",
    "gdf_fm = gpd.read_parquet(file_path_fm_parquet)\n",
    "\n",
    "# Print geodataframe\n",
    "gdf_fm"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1.5 Convert tiles csv to tiles parquet (remove faulty tiles)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [
