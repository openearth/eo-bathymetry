   "source": [
    "### 3.1 Convert GTSM zarr to csv"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Packages\n",
    "import numpy as np\n",
    "import os\n",
    "from tqdm import tqdm\n",
    "import xarray as xr"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# File paths in\n",
    "file_path_gtsm_zarr = r'p:\\1230882-emodnet_hrsm\\GTSMv3.0EMODnet\\CMEMS_intertidal_SDB\\zarr_files\\gtsm_model_his_combined_v2.zarr'\n",
    "\n",
    "# File paths out\n",
    "file_path_gtsm_csv = r'p:\\11209821-cmems-global-sdb\\01_intertidal\\02_data\\02_gtsm_files\\gtsm_waterlevels_{}_v2.csv'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Function to write gtsm zarr to csv\n",
    "def write_gtsm_zarr_to_csv(file_path_zarr, file_path_csv, variables=['waterlevel'], row_limit=np.inf, time_slice=None):\n",
    "    # Load gtsm\n",
    "    ds_gtsm = xr.open_zarr(file_path_zarr)\n",
    "\n",
    "    # Get time slice\n",
    "    if time_slice is not None:\n",
    "        ds_gtsm = ds_gtsm.sel(time=slice(time_slice[0], time_slice[1]))\n",
    "    \n",
    "    # Get stations, lons, lats and times\n",
    "    station_idxs = ds_gtsm.stations.values\n",
    "    station_ids = ds_gtsm.station_id.values\n",
    "    lons = ds_gtsm.station_x_coordinate.values\n",
    "    lats = ds_gtsm.station_y_coordinate.values\n",
    "    times = ds_gtsm.time.values\n",
    "\n",
    "    # Convert times to milliseconds\n",
    "    str_times = np.array([str(time) for time in times])\n",
    "    int_times = np.array([time.astype('datetime64[ms]').astype('int64') for time in times])\n",
    "\n",
    "    # Remove csv file if it already exists\n",
    "    if os.path.exists(file_path_csv):\n",
    "        os.remove(file_path_csv)\n",
    "\n",
    "    # Write data to csv\n",
    "    with open(file_path_csv, 'w') as f:\n",
    "        # Write header\n",
    "        header_str = 'geometry,system:time_start,system:time_end,station,times'\n",
    "        header_str += ''.join([',{}'.format(var) for var in variables]) + '\\n'\n",
    "        f.write(header_str)\n",
    "\n",
    "        # Get data per station\n",
    "        row_idx = 0\n",
    "        for station_idx, station_id in tqdm(zip(station_idxs, station_ids), total=len(station_idxs)):\n",
    "            # Determine non-nan time indices based on first variable\n",
    "            time_idxs = np.where(~np.isnan(ds_gtsm.isel(stations=station_idx)[variables[0]].values))[0]\n",
    "\n",
    "            # Get data for station\n",
    "            data = ds_gtsm.isel(stations=station_idx, time=time_idxs)[variables]\n",
    "            \n",
    "            # Get values\n",
    "            data = {var: data[var].values for var in variables}\n",
    "\n",
    "            # Get data per time step\n",
    "            for time_idx in time_idxs:\n",
    "                # Write data per station and time step\n",
    "                row_str = 'POINT ({lon} {lat}),{sys_stime},{sys_etime},{station},{time}'.format(\n",
    "                    lon=lons[station_idx], lat=lats[station_idx], sys_stime=int_times[time_idx], sys_etime=int_times[time_idx],\n",
    "                    station=station_id, time=str_times[time_idx])\n",
    "                row_str += ''.join([','+str(data[var][time_idx].item()) for var in variables]) + '\\n'\n",
    "                f.write(row_str)\n",
    "            \n",
    "                # Break if row limit is reached\n",
    "                row_idx += 1\n",
    "                if row_idx >= row_limit:\n",
    "                    break\n",
    "            \n",
    "            # Break if row limit is reached\n",
    "            if row_idx >= row_limit:\n",
    "                break"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Write gtsm zarr to csv\n",
    "for year in [2019, 2020, 2021, 2022, 2023]:\n",
    "    # Get file path\n",
    "    file_path_csv = file_path_gtsm_csv.format(year)\n",
    "    print(os.path.basename(file_path_csv))\n",
    "    \n",
    "    # Get time slice\n",
    "    time_slice = ['{}-01-01'.format(year), '{}-12-31'.format(year)]\n",
    "\n",
    "    # Write gtsm zarr to csv\n",
    "    done = False\n",
    "    while not done:\n",
    "        try:\n",
    "            write_gtsm_zarr_to_csv(file_path_gtsm_zarr, file_path_csv, time_slice=time_slice)\n",
    "            done = True\n",
    "        except Exception as e:\n",
    "            print(e)"
   ]
  },
