  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Packages\n",
    "import gcsfs\n",
    "import ee\n",
    "import os\n",
    "ee.Initialize()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Settings\n",
    "gcs_project = 'cmems-sdb'\n",
    "file_path_gcc = r'p:\\11209821-cmems-global-sdb\\00_miscellaneous\\KEYS\\bathymetry-543b622ddce7.json'\n",
    "bucket_name = 'cmems-sdb'\n",
    "bucket_proj = 'gtsm'\n",
    "file_path_gtsm_csv = r'p:\\11209821-cmems-global-sdb\\01_intertidal\\02_data\\02_gtsm_files\\gtsm_waterlevels_{}_v2.csv'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Function to upload file to Google Cloud Storage\n",
    "def upload_file_to_google_cloud_storage(gcs_project: str, file_path_gcc: str, bucket_name: str, bucket_proj: str, file_path: str):\n",
    "    # Get file system interface for google cloud storage\n",
    "    fs = gcsfs.GCSFileSystem(gcs_project, token=file_path_gcc)\n",
    "\n",
    "    # Get target path\n",
    "    target_path = 'gs://{}/{}/{}'.format(bucket_name, bucket_proj, os.path.basename(file_path))\n",
    "\n",
    "    # Remove target file if it already exists\n",
    "    if fs.exists(target_path):\n",
    "        print('Removing existing file: {}'.format(target_path))\n",
