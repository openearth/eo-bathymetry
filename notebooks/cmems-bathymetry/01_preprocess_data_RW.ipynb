   "metadata": {},
   "outputs": [],
   "source": [
    "# Packageas\n",
    "import geopandas as gpd"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# File paths in\n",
    "file_path_fm_parquet = r'p:\\11209821-cmems-global-sdb\\00_miscellaneous\\Feasibility_maps\\2024\\gebco_2024_latminus2_merge_result.parquet'\n",
    "\n",
    "# File paths out\n",
    "file_path_fm_ed_parquet = r'p:\\11209821-cmems-global-sdb\\00_miscellaneous\\Feasibility_maps\\2024\\gebco_2024_latminus2_merge_result_erosion_dilation.parquet'\n",
    "\n",
    "# Settings\n",
    "gebco_scale = 465 # Actually 463, but rounded up to the nearest 5 [m]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load feasibility map\n",
    "gdf_fm = gpd.read_parquet(file_path_fm_parquet)\n",
    "\n",
    "# Get mask where pixel value is 3.0\n",
    "gdf_fm = gdf_fm[gdf_fm['pixel_value'] == 3.0]\n",
    "\n",
    "# Apply erosion and dilation (divided by 2 to have half eroded on 2 sides (makes 1 in total) & fix for unequal buffer in EPSG3857\n",
    "# (Solution from: https://www.reddit.com/r/QGIS/comments/oo1jgh/buffer_points_on_epsg_4326_wgs_84/)\n",
    "gdf_fm_ed = gdf_fm.copy(deep=True)\n",
    "gdf_fm_ed['geometry'] = gdf_fm_ed['geometry'].buffer(-gebco_scale/2/111120)\n",
    "gdf_fm_ed['geometry'] = gdf_fm_ed['geometry'].buffer(gebco_scale/2/111120)"
   ]
